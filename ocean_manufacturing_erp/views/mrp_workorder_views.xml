<odoo>


    <!-- Inherit Work Order Form View -->
    <record id="mrp_production_workorder_form_view_inherit_ocean" model="ir.ui.view">
        <field name="name">mrp.production.work.order.form.inherit.ocean</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="button_start"
                        string="Start"
                        type="object"
                        class="btn-primary"
                        invisible="state in ('progress', 'done', 'cancel')"/>
                <button name="action_open_push_wizard"
                        string="Push"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'progress'"/>
                <button name="action_open_finish_wizard"
                        string="Finish"
                        type="object"
                        class="btn-success"
                        invisible="state != 'progress'"/>
            </header>

            <!-- Ensure Planned, Produced, and Remaining are clearly visible -->
            <xpath expr="//field[@name='qty_produced']" position="attributes">
                <attribute name="groups"></attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='qty_remaining']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>
            <xpath expr="//field[@name='qty_remaining']" position="before">
                <field name="qty_production" string="Planned Quantity" readonly="1"/>
            </xpath>

            <!-- Notes Tab -->
            <notebook position="inside">
                <page string="Process Notes" name="process_notes">
                    <group>
                        <group string="Previous Operation Notes" invisible="not previous_remarks">
                            <field name="previous_remarks" readonly="1" nolabel="1"/>
                        </group>
                        <group string="Notes">
                            <field name="remarks" nolabel="1" placeholder="Notes for this operation..."/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Ocean ERP Clean Standalone Manufacturing Actions (Pure Community View Modes) -->
    <record id="action_ocean_mrp_production" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
        <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
        <field name="context">{'search_default_todo': True}</field>
    </record>

    <record id="action_ocean_mrp_workorder" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="mrp.view_mrp_production_workorder_form_view_filter"/>
        <field name="context">{'search_default_ready': True, 'search_default_progress': True, 'search_default_blocked': True}</field>
    </record>

    <record id="action_ocean_mrp_workcenter" model="ir.actions.act_window">
        <field name="name">Work Centers</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
    </record>

    <record id="action_ocean_mrp_routing" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">mrp.routing.workcenter</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
