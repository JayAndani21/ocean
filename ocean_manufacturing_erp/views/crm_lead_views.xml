<odoo>

    <!-- Inherit CRM Lead Form View to add Drawing Tab -->
    <record id="crm_lead_view_form_inherit_drawing" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.drawing</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='internal_notes']" position="before">
                <page string="Drawing" name="drawing">
                    <field name="attachment_ids" widget="many2many_binary" string="Documents" nolabel="1"/>
                </page>
            </xpath>
            <xpath expr="//group/group[@name='lead_priority']" position="inside">
                <field name="material_grade_id" options="{'no_open': False, 'no_create': False}"/>
                <label for="section_size" string="Section"/>
                <div style="display: flex; align-items: center; gap: 5px;">
                    <field name="section_size" style="width: 50px; text-align: center;"/>
                    <span>mm</span>
                    <field name="section_type_id" style="width: 120px;" placeholder="Select Type..." options="{'no_open': False, 'no_create': False}"/>
                </div>
            </xpath>
            <xpath expr="//group/group[@invisible=&quot;type == 'lead'&quot;]" position="inside">
                <field name="material_grade_id" options="{'no_open': False, 'no_create': False}"/>
                <label for="section_size" string="Section"/>
                <div style="display: flex; align-items: center; gap: 5px;">
                    <field name="section_size" style="width: 50px; text-align: center;"/>
                    <span>mm</span>
                    <field name="section_type_id" style="width: 120px;" placeholder="Select Type..." options="{'no_open': False, 'no_create': False}"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
